# Provider: openai-compatible (HTTP, needs PREDICTOR_API_KEY), claude-cli
# (Claude Code CLI, Claude subscription) or codex-cli (OpenAI Codex CLI,
# ChatGPT subscription). The CLI providers resolve their own credentials.
PREDICTOR_PROVIDER=openai-compatible
# claude-cli only: effort override past ModelRequest's high (low|medium|high|xhigh|max).
PREDICTOR_CLAUDE_EFFORT=
# codex-cli only: model_reasoning_effort override (low|medium|high|xhigh|max|ultra).
PREDICTOR_CODEX_EFFORT=

# OpenAI-compatible forecasting model. Defaults target Foresight v4.
PREDICTOR_BASE_URL=https://api.lightningrod.ai/v1/openai
PREDICTOR_MODEL=foresight-v4
PREDICTOR_API_KEY=
PREDICTOR_TIMEOUT_MS=900000
PREDICTOR_TRIALS=3
PREDICTOR_CONCURRENCY=8
PREDICTOR_REASONING_EFFORT=medium
PREDICTOR_RESEARCH_SOURCES=perplexity,google_news
PREDICTOR_MAX_RETRIES=2
PREDICTOR_RETRY_BASE_MS=1000

# Prophet Arena raw endpoint.
PROPHET_HOST=127.0.0.1
PROPHET_PORT=8788
PROPHET_BEARER_TOKEN=
PROPHET_MAX_CONCURRENT=8
PROPHET_PROVIDER_CONCURRENCY=8
PROPHET_MAX_OUTCOMES=40
PROPHET_MAX_TOTAL_PROMPT_BYTES=1000000
PROPHET_REQUEST_TIMEOUT_MS=3300000
PROPHET_RESIDUAL_CAP=0.05
PROPHET_WIRE_MODE=auto
# Local smoke only. Production should keep this disabled and require a Predictor key.
PROPHET_ALLOW_BASELINE_ONLY=0
